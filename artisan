<?php
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

if (($argv[1] ?? '') !== 'serve') {
    fwrite(STDERR, "Usage: php artisan serve [--port=8000]\n");
    exit(1);
}

$port = '8000';
for ($index = 2; $index < $argc; $index++) {
    $argument = $argv[$index];
    if (str_starts_with($argument, '--port=')) {
        $port = substr($argument, 7);
    } elseif ($argument === '--port' && isset($argv[$index + 1])) {
        $port = $argv[++$index];
    } else {
        fwrite(STDERR, "Unsupported option: {$argument}\nUsage: php artisan serve [--port=8000]\n");
        exit(1);
    }
}

if (!ctype_digit($port) || (int) $port < 1 || (int) $port > 65535) {
    fwrite(STDERR, "Port must be a number between 1 and 65535.\n");
    exit(1);
}

$command = escapeshellarg(PHP_BINARY)
    . ' -S 127.0.0.1:' . (int) $port
    . ' -t ' . escapeshellarg(__DIR__);
passthru($command, $exitCode);
exit($exitCode);
